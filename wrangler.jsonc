{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pisell-cases",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./pisell-web/build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/admin",
      "/admin/*",
      "/admin.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS"
    }
  ],
  "keep_vars": true
}
