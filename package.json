{
  "name": "pisell-cases",
  "version": "2.0.0",
  "description": "Pisell customer case map and project management",
  "scripts": {
    "dev": "npm run build:web && node scripts/preview-pisell.cjs",
    "build": "node scripts/build-pisell.cjs",
    "build:web": "node scripts/build-pisell.cjs",
    "preview": "node scripts/preview-pisell.cjs",
    "preview:web": "node scripts/preview-pisell.cjs",
    "dev:cloudflare": "npm run build:web && wrangler dev",
    "deploy:cloudflare": "npm run build:web && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
